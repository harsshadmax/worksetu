# Worksetu backend — copy to .env and fill in real values. Never commit .env.

# Postgres (Supabase), pooled connection (PgBouncer, transaction mode) — used by the app at runtime
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Postgres (Supabase), direct/unpooled connection — used only by `prisma migrate`
DIRECT_URL=postgresql://user:password@host:5432/postgres

# HS256 signing secret for access tokens — high-entropy, never reused across environments
JWT_SECRET=replace-with-a-long-random-value

# Redis — dispatch locks, rate limiting, caching (Section 3.3, 4.10, 24.3)
REDIS_URL=redis://localhost:6379

# HTTP port the Express server listens on
PORT=4000

# development | production — gates verbose error detail (Section 8.5)
NODE_ENV=development

# Comma-separated explicit origin allowlist for CORS (Section 8.2) — never *.
# For the deployed frontend, add its exact Vercel URL, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Notification channel stubs (Section 18) — interface-ready, not wired to a real provider in this pass
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
