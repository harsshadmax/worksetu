# Worksetu — unified environment reference for both services.
# The backend reads its own copy from server/.env (copy server/.env.example
# there for local dev). This root file exists so every variable used
# anywhere in the app is documented in one place for deployment. Never
# commit a real .env file.

# ============================================================
# BACKEND (server/) — Express API, read via server/.env
# ============================================================

# Postgres (Supabase), pooled connection (PgBouncer, transaction mode) —
# used by the app at runtime. Existing, already-migrated, PostGIS-enabled,
# seeded database — see render.yaml for why this isn't Render-provisioned.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Postgres (Supabase), direct/unpooled connection — used only by `prisma migrate`
DIRECT_URL=postgresql://user:password@host:5432/postgres

# HS256 signing secret for access tokens — high-entropy, never reused across environments
JWT_SECRET=replace-with-a-long-random-value

# Redis (Upstash) — dispatch locks, rate limiting, caching
REDIS_URL=redis://localhost:6379

# HTTP port the Express server listens on — Render/most hosts inject this
# automatically; only set it yourself for local dev.
PORT=4000

# development | production — gates verbose error detail
NODE_ENV=development

# Comma-separated explicit origin allowlist for CORS — never *. This is the
# variable the CORS middleware actually reads (app.ts); functionally the
# same purpose as "ALLOWED_ORIGINS" — set it to your deployed frontend's
# exact URL, e.g.:
# CORS_ALLOWED_ORIGINS=https://worksetu-web.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Notification channel stubs — interface-ready, not wired to a real provider
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=

# ============================================================
# FRONTEND (index.html/app.js/api.js) — no build step, no .env file
# ============================================================
# The frontend is plain static HTML/JS (no bundler, so no Vite/webpack-style
# .env injection applies). Its one piece of runtime config — which backend
# to call — is set directly in index.html, right before the api.js/app.js
# script tags:
#
#   window.WORKSETU_API_BASE = "https://worksetu-api.onrender.com";
#
# Leave that line as the localhost fallback for local dev; set it to your
# deployed backend's exact URL before deploying the frontend.
